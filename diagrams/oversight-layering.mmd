flowchart LR
    subgraph INT["Internal control layer"]
        IG[Inspector General]
        IA[Internal audit unit]
        WB[Whistleblower channel]
    end
    subgraph EXE["Executive layer"]
        CSAT[CSAT]
        GOV[Government]
    end
    subgraph PAR["Parliamentary layer"]
        JPC[JPC - Parliament]
        ITAP[ITAP technical panel]
    end
    subgraph JUD["Judicial layer"]
        SSC[SSC - Surveillance Court]
        ICCJ[ICCJ]
    end
    subgraph PUB["Public layer"]
        CSO[Civil society]
        MED[Media]
        ACA[Academia]
    end
    AG[SRI - SIE - STS - SPP - DNSC]
    IA -->|reports to| IG
    WB -->|protected channel| IG
    AG -->|supervises| CSAT
    CSAT -->|accountable to| JPC
    IG -->|audit findings| JPC
    ITAP -->|technical validation| JPC
    AG -->|warrant requests| SSC
    SSC -->|warrant tokens| AG
    SSC -->|appeals| ICCJ
    JPC -->|public reports| PUB
    PUB -->|contestation| JPC
    CSO -->|protection requests| IG

    classDef int fill:#0f2a20,stroke:#34d399,color:#dce5f5,stroke-width:1px;
    classDef exec fill:#0f1a2e,stroke:#2b3f63,color:#dce5f5,stroke-width:1px;
    classDef par fill:#0e2436,stroke:#38bdf8,color:#dce5f5,stroke-width:1px;
    classDef jud fill:#1b1433,stroke:#a78bfa,color:#dce5f5,stroke-width:1px;
    classDef pub fill:#13213a,stroke:#7184a5,color:#dce5f5,stroke-width:1px;
    classDef svc fill:#2a1016,stroke:#fb7185,color:#fecdd3,stroke-width:1.5px;
    class IG,IA,WB int
    class CSAT,GOV exec
    class JPC,ITAP par
    class SSC,ICCJ jud
    class CSO,MED,ACA pub
    class AG svc
