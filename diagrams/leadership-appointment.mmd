flowchart LR
    V[Vacancy or end of term] --> CN[Public call for nominations]
    CN --> SC[Selection Committee screens candidates]
    SC --> S[Shortlist of 3 to 5 candidates]
    S --> JPC[JPC public hearing, sworn testimony]
    JPC --> VOTE[Confirmation vote in joint sitting]
    VOTE --> PASS{Vote passed?}
    PASS -->|No - back to shortlist| S
    PASS -->|Yes| RES[Parliamentary resolution adopted]
    RES --> APP[CSAT appointment within 15 days]
    APP --> TERM[Fixed 5-year term, one renewal]

    classDef step fill:#0f1a2e,stroke:#2b3f63,color:#dce5f5,stroke-width:1px;
    classDef gate fill:#0e2436,stroke:#38bdf8,color:#bae6fd,stroke-width:1.5px;
    classDef decide fill:#2a2410,stroke:#fbbf24,color:#fbbf24,stroke-width:1.5px;
    classDef good fill:#0f2a20,stroke:#34d399,color:#a7f3d0,stroke-width:1.5px;
    class V,CN,S,RES step
    class SC,JPC,VOTE gate
    class PASS decide
    class APP,TERM good
