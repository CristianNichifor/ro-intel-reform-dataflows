{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditLedgerEntry",
  "type": "object",
  "required": [
    "entry_id",
    "timestamp",
    "flow_type",
    "initiator",
    "receiver",
    "token_id",
    "metadata_hash",
    "previous_hash",
    "entry_hash"
  ],
  "properties": {
    "entry_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "flow_type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8",
        "T9",
        "T11",
        "T14",
        "T15",
        "T16",
        "T18"
      ]
    },
    "initiator": { "enum": ["SRI", "SIE", "DNSC", "DIICOT", "JPC", "OMB"] },
    "receiver": {
      "enum": ["SRI", "SIE", "DNSC", "DIICOT", "IG", "JPC", "CSAT", "ANSPDCP"]
    },
    "token_id": { "type": ["string", "null"], "format": "uuid" },
    "metadata_hash": {
      "type": "string",
      "description": "SHA-256 of request/response metadata (no content)"
    },
    "previous_hash": { "type": "string" },
    "entry_hash": { "type": "string" }
  }
}
